generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  username    String   @unique
  password    String   // Hash password (bcrypt)
  nickname    String?  @map("nickname")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  status      String   @default("active") // "active" | "inactive" | "suspended"
  role        Role     @default(USER)
  department  String?
  position    String?
  avatarUrl   String?  @map("avatar_url")
  telegramId  String?  @map("telegram_id")
  pinCode     String?  @map("pin_code")
  isAdAuth    Boolean  @default(false) @map("is_ad_auth") // Use Active Directory authentication
  devices     Json?    @default("[]")
  lastAccess  DateTime? @map("last_access")
  
  // Email Digest Settings
  emailDigestEnabled Boolean   @default(false) @map("email_digest_enabled")
  emailDigestTime    String?   @default("08:30") @map("email_digest_time")
  emailDigestTypes   Json?     @default("[\"my_tasks\", \"involved_tasks\", \"assigned_by_me\"]") @map("email_digest_types")
  lastDigestSentAt   DateTime? @map("last_digest_sent_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  likes       TaskLike[]
  reads       TaskRead[]

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Task {
  id               String   @id @default(uuid())
  title            String
  description      String?  @db.Text
  status           String   @default("todo") // "todo" | "in_progress" | "review" | "done"
  priority         String   @default("medium") // "low" | "medium" | "high"
  progress         Int      @default(0) // 0-100
  deadline         DateTime?
  avatarUrl        String?  @map("avatar_url")
  collaborators    Json?    // Array of user IDs (strings)
  createdBy        String?  @map("created_by")
  latestUpdate     String?  @db.Text @map("latest_update")
  projectOwner     String?  @map("project_owner")
  previousProgress Int      @default(0) @map("previous_progress")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignee      String
  manager       String?

  isArchived       Boolean  @default(false) @map("is_archived")
  archiveReason    String?  @map("archive_reason") @db.Text

  subtasks         Json?    @default("[]") // Array of { id, title, completed, createdAt }
  recurrence       String?  @default("none") // "none" | "daily" | "weekly" | "monthly"
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")

  comments         Comment[]
  likes            TaskLike[]
  reads            TaskRead[]
  activities       TaskActivity[]

  @@map("tasks")
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userName  String   @map("user_name")
  action    String   @db.VarChar(50) // "created", "status_change", "progress_change", "subtask_toggle", "deadline_change", "assignee_change"
  details   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt(sort: Desc)])
  @@map("task_activities")
}

model Comment {
  id        String   @id @default(uuid())
  task      String   @map("task") // Task ID
  user      String   @map("user") // commenter name string
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updateKey String?  @map("update_key") @db.Text

  // Relations
  taskRelation Task  @relation(fields: [task], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model LoginLog {
  id        String   @id @default(uuid())
  username  String
  authType  String   @map("auth_type") // "AD" | "LOCAL"
  ipAddress String   @map("ip_address")
  status    String   // "ACCEPT" | "REJECT" | "DENIED" | "ERROR"
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_logs")
}

model TaskLike {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  targetType String   @default("task") @map("target_type")
  targetId   String   @default("") @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, targetType, targetId])
  @@map("task_likes")
}

model TaskRead {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_reads")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?  @db.Text
  description String?  @db.VarChar(250)
  category    String   @default("general") @db.VarChar(50)
  dataType    String   @default("string") @map("data_type") @db.VarChar(20)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([key])
  @@map("system_settings")
}

model TransactionLog {
  id           Int      @id @default(autoincrement())
  category     String   @db.VarChar(50)
  action       String   @db.VarChar(100)
  status       String   @default("success") @db.VarChar(20)
  message      String   @db.VarChar(500)
  details      String?  @db.Text
  recordsCount Int      @default(0) @map("records_count")
  durationMs   Int      @default(0) @map("duration_ms")
  triggeredBy  String   @map("triggered_by") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("transaction_logs")
}

